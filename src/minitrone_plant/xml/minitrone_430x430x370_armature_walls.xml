<mujoco model="minitrone_430x430x370_walls">
  <!--

    Modified from minitrone_400x400x350_armature:
      - X-frame configuration is preserved.
      - XY coordinates were resized to target 430 x 430 mm.
      - Z geometry was resized to target 370 mm height.
      - Propeller visual disks are preserved.
      - Servo angle saturation and BLDC saturation are kept matched to crosstrone_450x450x300.
      - Servo bodies are ordered as servo1, servo2, servo3, servo4 in the XML definition.
      - Four massless collision-only outer wall geoms are added around the 430 x 430 mm envelope.

    Target collision envelope: approximately 0.430 m x 0.430 m x 0.370 m.

    Scaling used from the previous 400 x 400 x 350 file:
      XY scale = 1.075000000  (400 mm -> 430 mm)
      Z  scale = 1.057142857  (350 mm -> 370 mm)
      Pipe/propeller radii are preserved.

    Mass model:
      - All physical mass is concentrated in the main body CoM.
      - Body frame origin is placed at the CoM, geometric center z = 0.185 m.
      - Inertial values are updated using a cuboid approximation for the 430 x 430 x 370 mm geometry.
      - Servo hinge rotational inertia is represented by joint armature only.
      - Tiny dummy inertials on thruster/propeller bodies are numerical placeholders for MuJoCo compatibility.
  -->
  <compiler angle="radian" coordinate="local" inertiafromgeom="auto" />
  <option gravity="0 0 -9.81" timestep="0.002" />
  <default>
    <geom friction="0.8 0.1 0.1" density="0" />
    <joint damping="0.1" stiffness="0" />
  </default>
  <worldbody>
    <body name="drone_base" pos="0.000000000 0.000000000 0.185000000">
      <freejoint name="root" />
      <!-- All physical mass concentrated at the body-frame origin. -->
      <inertial pos="0.000000000 0.000000000 0.000000000" mass="2.5" diaginertia="0.0670417 0.0670417 0.0770417" />
      <site name="drone_imu" pos="0.000000000 0.000000000 0.000000000" quat="1 0 0 0" rgba="1 1 1 1" />

      <!-- Massless collision-only outer walls.
           These four box geoms are attached to drone_base, so they add no independent DOF.
           mass=0 keeps the walls from changing the vehicle mass/inertia.
           The outer faces lie on the +/-0.215 m XY envelope of the 430 x 430 mm body.
           Thickness is 6 mm inward; height spans the 370 mm body height. -->
      <geom name="outer_wall_px" type="box"
            pos="0.212000000 0.000000000 0.000000000"
            size="0.003000000 0.215000000 0.185000000"
            rgba="0.15 0.15 0.15 0.25"
            contype="1" conaffinity="1" group="0" mass="0" />

      <geom name="outer_wall_nx" type="box"
            pos="-0.212000000 0.000000000 0.000000000"
            size="0.003000000 0.215000000 0.185000000"
            rgba="0.15 0.15 0.15 0.25"
            contype="1" conaffinity="1" group="0" mass="0" />

      <geom name="outer_wall_py" type="box"
            pos="0.000000000 0.212000000 0.000000000"
            size="0.215000000 0.003000000 0.185000000"
            rgba="0.15 0.15 0.15 0.25"
            contype="1" conaffinity="1" group="0" mass="0" />

      <geom name="outer_wall_ny" type="box"
            pos="0.000000000 -0.212000000 0.000000000"
            size="0.215000000 0.003000000 0.185000000"
            rgba="0.15 0.15 0.15 0.25"
            contype="1" conaffinity="1" group="0" mass="0" />
      <!-- Bottom X-frame pipes -->
      <geom name="xpipe_bottome1" type="capsule" fromto="-0.206249572 -0.206249572 -0.113007850 0.206249572 0.206249572 -0.113007850" size="0.005426622" rgba="0.5 0.5 0.5 1" contype="1" conaffinity="1" group="0" mass="0" />
      <geom name="xpipe_bottome2" type="capsule" fromto="-0.206249572 0.206249572 -0.113007850 0.206249572 -0.206249572 -0.113007850" size="0.005426622" rgba="0.5 0.5 0.5 1" contype="1" conaffinity="1" group="0" mass="0" />
      <!-- Top X-frame pipes -->
      <geom name="xpipe_top1" type="capsule" fromto="-0.206249572 -0.206249572 0.176394928 0.206249572 0.206249572 0.176394928" size="0.008139933" rgba="0.5 0.5 0.5 1" contype="1" conaffinity="1" group="0" mass="0" />
      <geom name="xpipe_top2" type="capsule" fromto="-0.206249572 0.206249572 0.176394928 0.206249572 -0.206249572 0.176394928" size="0.008139933" rgba="0.5 0.5 0.5 1" contype="1" conaffinity="1" group="0" mass="0" />
      <!-- Legs and feet -->
      <geom name="leg1_shaft" type="capsule" fromto="-0.206249572 0.206249572 -0.177800785 -0.206249572 0.206249572 0.176394928" size="0.005426622" contype="1" conaffinity="1" group="0" mass="0" />
      <geom name="leg1_foot" type="box" pos="-0.206249572 0.206249572 -0.177800785" size="0.005426622 0.005426622 0.007199215" contype="1" conaffinity="1" group="0" mass="0" />
      <geom name="leg2_shaft" type="capsule" fromto="0.206249572 0.206249572 -0.177800785 0.206249572 0.206249572 0.176394928" size="0.005426622" contype="1" conaffinity="1" group="0" mass="0" />
      <geom name="leg2_foot" type="box" pos="0.206249572 0.206249572 -0.177800785" size="0.005426622 0.005426622 0.007199215" contype="1" conaffinity="1" group="0" mass="0" />
      <geom name="leg3_shaft" type="capsule" fromto="0.206249572 -0.206249572 -0.177800785 0.206249572 -0.206249572 0.176394928" size="0.005426622" contype="1" conaffinity="1" group="0" mass="0" />
      <geom name="leg3_foot" type="box" pos="0.206249572 -0.206249572 -0.177800785" size="0.005426622 0.005426622 0.007199215" contype="1" conaffinity="1" group="0" mass="0" />
      <geom name="leg4_shaft" type="capsule" fromto="-0.206249572 -0.206249572 -0.177800785 -0.206249572 -0.206249572 0.176394928" size="0.005426622" contype="1" conaffinity="1" group="0" mass="0" />
      <geom name="leg4_foot" type="box" pos="-0.206249572 -0.206249572 -0.177800785" size="0.005426622 0.005426622 0.007199215" contype="1" conaffinity="1" group="0" mass="0" />
      <!-- Thruster/servo bodies. Physical mass removed; hinge inertia is in armature.
           Numbering follows Palletrone.xml:
             1: +x +y, 2: -x +y, 3: -x -y, 4: +x -y.
           Propeller disks are visual/non-collision cylinders copied from the crosstrone style
           and placed at each X-frame propeller site. -->
      <body name="servo1" pos="0.120913386 0.120913386 0.126394928" quat="0.9238795 0 0 0.3826834">
        <inertial pos="0.000000000 0.000000000 0.000000000" mass="1e-9" diaginertia="1e-12 1e-12 1e-12" />
        <joint name="j_servo1" type="hinge" axis="1 0 0" pos="0.000000000 0.000000000 0.000000000" limited="true" range="-1.57079632679 1.57079632679" armature="0.005" damping="0.02" />
        <body name="prop1_body" pos="0.000000000 0.000000000 0.000000000">
          <geom name="prop1_col" type="cylinder" pos="0.000000000 0.000000000 0.000000000" size="0.0762 0.001" mass="1e-9" rgba="0.85 0.55 0.0 0.7" contype="0" conaffinity="0" group="1" />
          <site name="prop1_site" pos="0.000000000 0.000000000 0.000000000" size="0.005426622" type="sphere" rgba="1 1 1 0" />
        </body>
      </body>
      <body name="servo2" pos="-0.120913386 0.120913386 0.126394928" quat="0.3826834 0 0 0.9238795">
        <!-- Tiny dummy inertia for MuJoCo compile stability; not intended as physical mass. -->
        <inertial pos="0.000000000 0.000000000 0.000000000" mass="1e-9" diaginertia="1e-12 1e-12 1e-12" />
        <joint name="j_servo2" type="hinge" axis="1 0 0" pos="0.000000000 0.000000000 0.000000000" limited="true" range="-1.57079632679 1.57079632679" armature="0.005" damping="0.02" />
        <body name="prop2_body" pos="0.000000000 0.000000000 -0.000000000">
          <geom name="prop2_col" type="cylinder" pos="0.000000000 0.000000000 0.000000000" size="0.0762 0.001" mass="1e-9" rgba="0.85 0.55 0.0 0.7" contype="0" conaffinity="0" group="2" />
          <site name="prop2_site" pos="0.000000000 0.000000000 0.000000000" size="0.005426622" type="sphere" rgba="1 1 1 0" />
        </body>
      </body>
      <body name="servo3" pos="-0.120913386 -0.120913386 0.126394928" quat="0.3826834 0 0 -0.9238795">
        <inertial pos="0.000000000 0.000000000 0.000000000" mass="1e-9" diaginertia="1e-12 1e-12 1e-12" />
        <joint name="j_servo3" type="hinge" axis="1 0 0" pos="0.000000000 0.000000000 0.000000000" limited="true" range="-1.57079632679 1.57079632679" armature="0.005" damping="0.02" />
        <body name="prop3_body" pos="0.000000000 0.000000000 -0.000000000">
          <geom name="prop3_col" type="cylinder" pos="0.000000000 0.000000000 0.000000000" size="0.0762 0.001" mass="1e-9" rgba="0.85 0.55 0.0 0.7" contype="0" conaffinity="0" group="3" />
          <site name="prop3_site" pos="0.000000000 0.000000000 0.000000000" size="0.005426622" type="sphere" rgba="1 1 1 0" />
        </body>
      </body>
      <body name="servo4" pos="0.120913386 -0.120913386 0.126394928" quat="0.9238795 0 0 -0.3826834">
        <inertial pos="0.000000000 0.000000000 0.000000000" mass="1e-9" diaginertia="1e-12 1e-12 1e-12" />
        <joint name="j_servo4" type="hinge" axis="1 0 0" pos="0.000000000 0.000000000 0.000000000" limited="true" range="-1.57079632679 1.57079632679" armature="0.005" damping="0.02" />
        <body name="prop4_body" pos="0.000000000 0.000000000 0.000000000">
          <geom name="prop4_col" type="cylinder" pos="0.000000000 0.000000000 0.000000000" size="0.0762 0.001" mass="1e-9" rgba="0.85 0.55 0.0 0.7" contype="0" conaffinity="0" group="4" />
          <site name="prop4_site" pos="0.000000000 0.000000000 0.000000000" size="0.005426622" type="sphere" rgba="1 1 1 0" />
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <general name="BLDC1" site="prop1_site" gear="0 0 1 0 0  0.02" ctrlrange="0 15" />
    <general name="BLDC2" site="prop2_site" gear="0 0 1 0 0 -0.02" ctrlrange="0 15" />
    <general name="BLDC3" site="prop3_site" gear="0 0 1 0 0  0.02" ctrlrange="0 15" />
    <general name="BLDC4" site="prop4_site" gear="0 0 1 0 0 -0.02" ctrlrange="0 15" />
    <position name="servo1_pos" joint="j_servo1" kp="10" kv="0.2" ctrlrange="-1.57079632679 1.57079632679" />
    <position name="servo2_pos" joint="j_servo2" kp="10" kv="0.2" ctrlrange="-1.57079632679 1.57079632679" />
    <position name="servo3_pos" joint="j_servo3" kp="10" kv="0.2" ctrlrange="-1.57079632679 1.57079632679" />
    <position name="servo4_pos" joint="j_servo4" kp="10" kv="0.2" ctrlrange="-1.57079632679 1.57079632679" />
  </actuator>
  <sensor>
    <!-- IMU site: drone_imu -->
    <framequat name="body_quat" objtype="site" objname="drone_imu" />
    <gyro name="body_gyro" site="drone_imu" />
    <!-- Base body: drone_base -->
    <framepos name="base_pos" objtype="body" objname="drone_base" />
    <framelinvel name="base_linvel" objtype="body" objname="drone_base" />
    <!-- Servo sensors -->
    <jointpos name="servo1_angle" joint="j_servo1" />
    <jointpos name="servo2_angle" joint="j_servo2" />
    <jointpos name="servo3_angle" joint="j_servo3" />
    <jointpos name="servo4_angle" joint="j_servo4" />
    <jointvel name="servo1_vel" joint="j_servo1" />
    <jointvel name="servo2_vel" joint="j_servo2" />
    <jointvel name="servo3_vel" joint="j_servo3" />
    <jointvel name="servo4_vel" joint="j_servo4" />
    <!-- Propeller site states -->
    <framepos name="prop1_pos" objtype="site" objname="prop1_site" />
    <framepos name="prop2_pos" objtype="site" objname="prop2_site" />
    <framepos name="prop3_pos" objtype="site" objname="prop3_site" />
    <framepos name="prop4_pos" objtype="site" objname="prop4_site" />
    <framequat name="prop1_quat" objtype="site" objname="prop1_site" />
    <framequat name="prop2_quat" objtype="site" objname="prop2_site" />
    <framequat name="prop3_quat" objtype="site" objname="prop3_site" />
    <framequat name="prop4_quat" objtype="site" objname="prop4_site" />
    <framelinvel name="prop1_linvel" objtype="site" objname="prop1_site" />
    <framelinvel name="prop2_linvel" objtype="site" objname="prop2_site" />
    <framelinvel name="prop3_linvel" objtype="site" objname="prop3_site" />
    <framelinvel name="prop4_linvel" objtype="site" objname="prop4_site" />
    <frameangvel name="prop1_angvel" objtype="site" objname="prop1_site" />
    <frameangvel name="prop2_angvel" objtype="site" objname="prop2_site" />
    <frameangvel name="prop3_angvel" objtype="site" objname="prop3_site" />
    <frameangvel name="prop4_angvel" objtype="site" objname="prop4_site" />
  </sensor>
</mujoco>
