<mujoco model="Minitrone">
  <include file="Follower.xml"/>
  <include file="palm.xml"/>
  <include file="contact_box.xml"/>

  <visual>
    <scale com="0.03"/>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0.0 0.0 0.0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="45" elevation="35.264" ellipsoidinertia="false"/>
  </visual>

  <asset>
    <!-- Muted slate-blue backdrop and a neutral grid for clear depth cues. -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" specular="0" shininess="0"/>
  </asset>

  <worldbody>
    <light pos="0 0 10" dir="0 0 -1" directional="true"
      diffuse="0.225 0.24 0.275" specular="0.04 0.04 0.05"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="1" conaffinity="1"/>


  </worldbody>
</mujoco>
